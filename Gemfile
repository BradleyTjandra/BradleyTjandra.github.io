source "https://rubygems.org"

# Matches the version GitHub Pages runs, so local previews behave like production.
gem "github-pages", group: :jekyll_plugins
gem "webrick", "~> 1.8"

# Windows and JRuby ship no zoneinfo database; needed for `timezone:` in _config.yml.
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
